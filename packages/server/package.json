{
  "name": "@kanto-mmo/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Colyseus game server for Kanto MMO.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.35",
    "@colyseus/ws-transport": "^0.15.3",
    "@kanto-mmo/shared": "0.1.0",
    "colyseus": "^0.15.39",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.19.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
