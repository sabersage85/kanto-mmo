# Postgres connection string used by packages/server (Drizzle ORM).
# Copy this file to .env and adjust if needed. If DATABASE_URL is unset,
# the server falls back to an in-memory persistence store (fine for a
# quick try, but data is lost on restart) — see README "Database setup".
DATABASE_URL=postgres://kanto:kanto@localhost:5432/kanto_mmo

# Port the Colyseus + Express server listens on.
PORT=2567
